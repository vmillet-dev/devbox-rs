/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": []
  },
  // `src/testing` is otherwise only reachable through the specs that import it;
  // a setup file, which nothing imports, would be bundled without being
  // type-checked — and the builder warns about exactly that.
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts", "src/testing/**/*.ts"]
}
